import Journal from './pages/journal/Journal';
import Reports from './pages/reports/Reports';
import Settings from './pages/settings/Settings';
import { Toaster } from 'react-hot-toast';

function App() {
  const [user, setUser] = useState(null);
  useEffect(() => {
    const saved = localStorage.getItem('talia_user');
    if (saved) setUser(JSON.parse(saved));
  }, []);
  const handleLogin = (userData) => { setUser(userData); localStorage.setItem('talia_user', JSON.stringify(userData)); };
  const handleLogout = () => { setUser(null); localStorage.removeItem('talia_user'); };

  return (
