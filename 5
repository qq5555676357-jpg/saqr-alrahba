$mainContent = @'
const { app, BrowserWindow, ipcMain, dialog } = require("electron");
const path = require("path");
const { initDatabase, getDb } = require("../database/database");
let mainWindow;

function createWindow() {
  mainWindow = new BrowserWindow({
    width: 1400, height: 900,
    webPreferences: { preload: path.join(__dirname, "../preload.js"), contextIsolation: true, nodeIntegration: false }
  });
  mainWindow.loadFile(path.join(__dirname, "../../build/index.html"));
}

app.whenReady().then(async () => {
  await initDatabase();
  const db = getDb();

  // ---- IPC Handlers ----
  // Auth
  ipcMain.handle("auth:login", (_, { username, password }) => {
    const bcrypt = require("bcrypt");
    const user = db.prepare("SELECT * FROM users WHERE username=? AND is_active=1").get(username);
    if (!user) return { success: false, message: "اسم المستخدم غير موجود" };
    if (!bcrypt.compareSync(password, user.password_hash)) return { success: false, message: "كلمة المرور خاطئة" };
    return { success: true, user: { id: user.id, username: user.username, full_name: user.full_name, role: user.role } };
  });

  // Dashboard
  ipcMain.handle("dashboard:getData", () => {
    const totalSales = db.prepare("SELECT COALESCE(SUM(total_amount),0) as t FROM invoices WHERE invoice_type='sales' AND status!='cancelled'").get().t;
    const customersCount = db.prepare("SELECT COUNT(*) as c FROM customers").get().c;
    return { success: true, data: { totalSales, customersCount } };
  });

  // Accounts CRUD
  ipcMain.handle("accounts:getAll", () => ({ success: true, data: db.prepare("SELECT * FROM accounts ORDER BY code").all() }));
  ipcMain.handle("accounts:create", (_, data) => {
    const { code, name, type, level } = data;
    db.prepare("INSERT INTO accounts (code,name,type,level) VALUES (?,?,?,?)").run(code, name, type, level || 1);
    return { success: true };
  });

  // Customers CRUD
  ipcMain.handle("customers:getAll", () => ({ success: true, data: db.prepare("SELECT * FROM customers ORDER BY name").all() }));
  ipcMain.handle("customers:create", (_, data) => {
    const { name, phone, email, address, city, tax_number, credit_limit } = data;
    const code = "C" + Date.now();
    db.prepare("INSERT INTO customers (code,name,phone,email,address,city,tax_number,credit_limit) VALUES (?,?,?,?,?,?,?,?)")
      .run(code, name, phone, email, address, city, tax_number, credit_limit || 0);
    return { success: true, code };
  });
  ipcMain.handle("customers:getStatement", (_, { customerId, startDate, endDate }) => {
    const customer = db.prepare("SELECT * FROM customers WHERE id=?").get(customerId);
    const invoices = db.prepare("SELECT * FROM invoices WHERE customer_id=? AND invoice_date BETWEEN ? AND ? ORDER BY invoice_date").all(customerId, startDate || '2020-01-01', endDate || '2099-12-31');
    const payments = db.prepare("SELECT * FROM payments WHERE customer_id=? AND payment_date BETWEEN ? AND ? ORDER BY payment_date").all(customerId, startDate || '2020-01-01', endDate || '2099-12-31');
    return { success: true, data: { customer, invoices, payments } };
  });

  // Vendors CRUD
  ipcMain.handle("vendors:getAll", () => ({ success: true, data: db.prepare("SELECT * FROM vendors ORDER BY name").all() }));
  ipcMain.handle("vendors:create", (_, data) => {
    const { name, phone, email, address, tax_number } = data;
    const code = "V" + Date.now();
    db.prepare("INSERT INTO vendors (code,name,phone,email,address,tax_number) VALUES (?,?,?,?,?,?)")
      .run(code, name, phone, email, address, tax_number);
    return { success: true, code };
  });

  // Inventory CRUD
  ipcMain.handle("inventory:getAll", () => ({ success: true, data: db.prepare("SELECT * FROM inventory_items ORDER BY name").all() }));
  ipcMain.handle("inventory:create", (_, data) => {
    const { name, unit, cost_price, selling_price, quantity, min_quantity } = data;
    const code = "I" + Date.now();
    db.prepare("INSERT INTO inventory_items (code,name,unit,cost_price,selling_price,quantity,min_quantity) VALUES (?,?,?,?,?,?,?)")
      .run(code, name, unit || 'piece', cost_price, selling_price, quantity || 0, min_quantity || 0);
    return { success: true, code };
  });
  ipcMain.handle("inventory:adjustStock", (_, { id, quantity, reason }) => {
    db.prepare("UPDATE inventory_items SET quantity=quantity+? WHERE id=?").run(quantity, id);
    return { success: true };
  });

  // Invoices
  ipcMain.handle("invoices:getAll", (_, filters) => {
    let query = "SELECT i.*, c.name as customer_name, v.name as vendor_name FROM invoices i LEFT JOIN customers c ON i.customer_id=c.id LEFT JOIN vendors v ON i.vendor_id=v.id WHERE 1=1";
    const params = [];
    if (filters?.type) { query += " AND i.invoice_type=?"; params.push(filters.type); }
    if (filters?.status) { query += " AND i.status=?"; params.push(filters.status); }
    query += " ORDER BY i.created_at DESC LIMIT 200";
    return { success: true, data: db.prepare(query).all(...params) };
  });
  ipcMain.handle("invoices:create", (_, { invoice, items }) => {
    const insertInvoice = db.prepare(`INSERT INTO invoices (invoice_number,invoice_type,customer_id,vendor_id,invoice_date,due_date,subtotal,vat_amount,discount_amount,total_amount,status,payment_terms,notes) VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?)`);
    const insertItem = db.prepare(`INSERT INTO invoice_items (invoice_id,inventory_id,description,quantity,unit_price,vat_percent,total_price) VALUES (?,?,?,?,?,?,?)`);
    const transaction = db.transaction(() => {
      const invNumber = "INV-" + Date.now();
      const result = insertInvoice.run(invNumber, invoice.invoice_type, invoice.customer_id, invoice.vendor_id, invoice.invoice_date, invoice.due_date, invoice.subtotal, invoice.vat_amount, invoice.discount_amount || 0, invoice.total_amount, invoice.status || 'pending', invoice.payment_terms || 'cash', invoice.notes);
      const invoiceId = result.lastInsertRowid;
      items.forEach(item => insertItem.run(invoiceId, item.inventory_id, item.description, item.quantity, item.unit_price, item.vat_percent || 15, item.total_price));
      // حركة مخزون
      if (invoice.invoice_type === 'sales' || invoice.invoice_type === 'sales_return') {
        const qtyChange = invoice.invoice_type === 'sales' ? -item.quantity : item.quantity;
        db.prepare("UPDATE inventory_items SET quantity=quantity+? WHERE id=?").run(qtyChange, item.inventory_id);
      }
      return invoiceId;
    });
    try {
      const invoiceId = transaction();
      return { success: true, id: invoiceId };
    } catch (e) {
      return { success: false, message: e.message };
    }
  });

  // Payments
  ipcMain.handle("payments:create", (_, data) => {
    const { payment_type, payment_date, customer_id, vendor_id, invoice_id, amount, payment_method, reference_number } = data;
    const pn = "PAY-" + Date.now();
    const result = db.prepare("INSERT INTO payments (payment_number,payment_type,payment_date,customer_id,vendor_id,invoice_id,amount,payment_method,reference_number) VALUES (?,?,?,?,?,?,?,?,?)")
      .run(pn, payment_type, payment_date, customer_id || null, vendor_id || null, invoice_id || null, amount, payment_method || 'cash', reference_number);
    if (invoice_id) {
      const inv = db.prepare("SELECT * FROM invoices WHERE id=?").get(invoice_id);
      const newPaid = inv.paid_amount + amount;
      const newBalance = inv.total_amount - newPaid;
      const newStatus = newBalance <= 0 ? 'paid' : (newPaid > 0 ? 'partially_paid' : 'pending');
      db.prepare("UPDATE invoices SET paid_amount=?, balance_amount=?, status=? WHERE id=?").run(newPaid, newBalance, newStatus, invoice_id);
    }
    return { success: true };
  });

  // Journal Entries
  ipcMain.handle("journal:getAll", () => ({ success: true, data: db.prepare("SELECT * FROM journal_entries ORDER BY entry_date DESC").all() }));
  ipcMain.handle("journal:create", (_, { entry, lines }) => {
    const insertEntry = db.prepare("INSERT INTO journal_entries (entry_number,entry_date,description,reference_type,reference_id) VALUES (?,?,?,?,?)");
    const insertLine = db.prepare("INSERT INTO journal_entry_lines (journal_entry_id,account_id,description,debit,credit) VALUES (?,?,?,?,?)");
    const transaction = db.transaction(() => {
      const en = "JE-" + Date.now();
      const res = insertEntry.run(en, entry.entry_date, entry.description, entry.reference_type, entry.reference_id);
      const entryId = res.lastInsertRowid;
      let totalDr = 0, totalCr = 0;
      lines.forEach(l => { insertLine.run(entryId, l.account_id, l.description, l.debit || 0, l.credit || 0); totalDr += (l.debit || 0); totalCr += (l.credit || 0); });
      if (Math.abs(totalDr - totalCr) > 0.01) throw new Error("القيد غير متوازن");
      return entryId;
    });
    try { return { success: true, id: transaction() }; }
    catch(e) { return { success: false, message: e.message }; }
  });

  // Reports
  ipcMain.handle("reports:trialBalance", (_, { startDate, endDate }) => {
    const data = db.prepare(`SELECT a.code, a.name, COALESCE(SUM(jel.debit),0) as total_debit, COALESCE(SUM(jel.credit),0) as total_credit FROM accounts a LEFT JOIN journal_entry_lines jel ON a.id=jel.account_id LEFT JOIN journal_entries je ON jel.journal_entry_id=je.id WHERE je.entry_date BETWEEN ? AND ? AND je.is_posted=1 GROUP BY a.id HAVING total_debit>0 OR total_credit>0 ORDER BY a.code`)
      .all(startDate || '2024-01-01', endDate || '2024-12-31');
    return { success: true, data };
  });
  ipcMain.handle("reports:incomeStatement", (_, { startDate, endDate }) => {
    const revenues = db.prepare("SELECT a.name, COALESCE(SUM(jel.credit - jel.debit),0) as amount FROM accounts a JOIN journal_entry_lines jel ON a.id=jel.account_id JOIN journal_entries je ON jel.journal_entry_id=je.id WHERE a.type='income' AND je.entry_date BETWEEN ? AND ? AND je.is_posted=1 GROUP BY a.id ORDER BY a.code").all(startDate||'2024-01-01', endDate||'2024-12-31');
    const expenses = db.prepare("SELECT a.name, COALESCE(SUM(jel.debit - jel.credit),0) as amount FROM accounts a JOIN journal_entry_lines jel ON a.id=jel.account_id JOIN journal_entries je ON jel.journal_entry_id=je.id WHERE a.type='expense' AND je.entry_date BETWEEN ? AND ? AND je.is_posted=1 GROUP BY a.id ORDER BY a.code").all(startDate||'2024-01-01', endDate||'2024-12-31');
    return { success: true, data: { revenues, expenses } };
  });
  ipcMain.handle("reports:balanceSheet", (_, { date }) => {
    const assets = db.prepare("SELECT a.name, COALESCE(SUM(jel.debit - jel.credit),0) as amount FROM accounts a LEFT JOIN journal_entry_lines jel ON a.id=jel.account_id LEFT JOIN journal_entries je ON jel.journal_entry_id=je.id AND je.entry_date<=? WHERE a.type='asset' GROUP BY a.id ORDER BY a.code").all(date||'2024-12-31');
    const liabilities = db.prepare("SELECT a.name, COALESCE(SUM(jel.credit - jel.debit),0) as amount FROM accounts a LEFT JOIN journal_entry_lines jel ON a.id=jel.account_id LEFT JOIN journal_entries je ON jel.journal_entry_id=je.id AND je.entry_date<=? WHERE a.type='liability' GROUP BY a.id ORDER BY a.code").all(date||'2024-12-31');
    const equity = db.prepare("SELECT a.name, COALESCE(SUM(jel.credit - jel.debit),0) as amount FROM accounts a LEFT JOIN journal_entry_lines jel ON a.id=jel.account_id LEFT JOIN journal_entries je ON jel.journal_entry_id=je.id AND je.entry_date<=? WHERE a.type='equity' GROUP BY a.id ORDER BY a.code").all(date||'2024-12-31');
    return { success: true, data: { assets, liabilities, equity } };
  });

  // Settings
  ipcMain.handle("settings:getAll", () => {
    const rows = db.prepare("SELECT * FROM settings").all();
    const settings = {};
    rows.forEach(r => settings[r.key] = r.value);
    return { success: true, data: settings };
  });
  ipcMain.handle("settings:update", (_, settingsObj) => {
    const upsert = db.prepare("INSERT OR REPLACE INTO settings (key,value) VALUES (?,?)");
    Object.entries(settingsObj).forEach(([key, value]) => upsert.run(key, String(value)));
    return { success: true };
  });

  // Export
  ipcMain.handle("export:excel", async (_, { type, data }) => {
    const XLSX = require("xlsx");
    const { filePath } = await dialog.showSaveDialog({ filters: [{ name: 'Excel', extensions: ['xlsx'] }] });
    if (filePath) { const ws = XLSX.utils.json_to_sheet(data); const wb = XLSX.utils.book_new(); XLSX.utils.book_append_sheet(wb, ws, type); XLSX.writeFile(wb, filePath); return { success: true, path: filePath }; }
    return { success: false, message: "تم الإلغاء" };
  });
  ipcMain.handle("export:pdf", async (_, { type, data, title }) => {
    const PDFDocument = require("pdfkit");
    const { filePath } = await dialog.showSaveDialog({ filters: [{ name: 'PDF', extensions: ['pdf'] }] });
    if (filePath) {
      const doc = new PDFDocument(); doc.pipe(require("fs").createWriteStream(filePath));
      doc.fontSize(18).text("TALIA Accounting", { align: 'center' }); doc.moveDown();
      doc.fontSize(10).text(JSON.stringify(data)); doc.end();
      return { success: true, path: filePath };
    }
    return { success: false, message: "تم الإلغاء" };
  });

  createWindow();
});

app.on("window-all-closed", () => { if (process.platform !== "darwin") app.quit(); });
