import React, { useState } from 'react';
import toast from 'react-hot-toast';
export default function Reports() {
  const [report, setReport] = useState('trial');
  const [data, setData] = useState(null);
  const loadReport = async () => {
    if (!window.talia) { toast.error('البيئة غير متصلة'); return; }
    let res;
    if (report === 'trial') res = await window.talia.getTrialBalance('2024-01-01','2024-12-31');
    else if (report === 'income') res = await window.talia.getIncomeStatement('2024-01-01','2024-12-31');
    else if (report === 'balance') res = await window.talia.getBalanceSheet('2024-12-31');
    if (res.success) setData(res.data);
  };
  return <div>
    <h2>التقارير المالية</h2>
    <div style={{display:'flex',gap:10,marginBottom:20}}>
      <button className={`btn ${report==='trial'?'btn-primary':'btn-secondary'}`} onClick={()=>setReport('trial')}>ميزان المراجعة</button>
      <button className={`btn ${report==='income'?'btn-primary':'btn-secondary'}`} onClick={()=>setReport('income')}>قائمة الدخل</button>
      <button className={`btn ${report==='balance'?'btn-primary':'btn-secondary'}`} onClick={()=>setReport('balance')}>الميزانية</button>
      <button className="btn btn-primary" onClick={loadReport}>عرض</button>
    </div>
