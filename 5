const Database = require("better-sqlite3"); const path = require("path"); const fs = require("fs");
const bcrypt = require("bcrypt"); const { app } = require("electron"); let db;

function getDbPath() {
  const userDataPath = app ? app.getPath("userData") : path.join(__dirname, "../../data");
  if (!fs.existsSync(userDataPath)) fs.mkdirSync(userDataPath, { recursive: true });
  return path.join(userDataPath, "talia.db");
}

function initDatabase() {
  const dbPath = getDbPath(); db = new Database(dbPath);
  db.pragma("journal_mode = WAL"); db.pragma("foreign_keys = ON");
  createTables(); seedData(); return db;
}

function createTables() {
  db.exec(`
    CREATE TABLE IF NOT EXISTS accounts (id INTEGER PRIMARY KEY AUTOINCREMENT, code TEXT NOT NULL UNIQUE, name TEXT NOT NULL, type TEXT NOT NULL CHECK(type IN ('asset','liability','equity','income','expense','contra_asset','contra_liability')), level INTEGER DEFAULT 1, parent_id INTEGER, opening_balance REAL DEFAULT 0, current_balance REAL DEFAULT 0);
    CREATE TABLE IF NOT EXISTS customers (id INTEGER PRIMARY KEY AUTOINCREMENT, code TEXT UNIQUE, name TEXT NOT NULL, phone TEXT, email TEXT, address TEXT, city TEXT, tax_number TEXT, credit_limit REAL DEFAULT 0, balance REAL DEFAULT 0);
    CREATE TABLE IF NOT EXISTS vendors (id INTEGER PRIMARY KEY AUTOINCREMENT, code TEXT UNIQUE, name TEXT NOT NULL, phone TEXT, email TEXT, address TEXT, tax_number TEXT, balance REAL DEFAULT 0);
    CREATE TABLE IF NOT EXISTS inventory_items (id INTEGER PRIMARY KEY AUTOINCREMENT, code TEXT UNIQUE, barcode TEXT, name TEXT NOT NULL, unit TEXT DEFAULT 'piece', cost_price REAL DEFAULT 0, selling_price REAL DEFAULT 0, quantity REAL DEFAULT 0, min_quantity REAL DEFAULT 0);
    CREATE TABLE IF NOT EXISTS invoices (id INTEGER PRIMARY KEY AUTOINCREMENT, invoice_number TEXT NOT NULL UNIQUE, invoice_type TEXT NOT NULL CHECK(invoice_type IN ('sales','purchase','sales_return','purchase_return')), customer_id INTEGER, vendor_id INTEGER, invoice_date DATE NOT NULL, due_date DATE, subtotal REAL NOT NULL DEFAULT 0, vat_amount REAL DEFAULT 0, discount_amount REAL DEFAULT 0, total_amount REAL NOT NULL DEFAULT 0, paid_amount REAL DEFAULT 0, balance_amount REAL DEFAULT 0, status TEXT DEFAULT 'pending' CHECK(status IN ('draft','pending','partially_paid','paid','cancelled')), payment_terms TEXT DEFAULT 'cash', notes TEXT);
    CREATE TABLE IF NOT EXISTS invoice_items (id INTEGER PRIMARY KEY AUTOINCREMENT, invoice_id INTEGER NOT NULL, inventory_id INTEGER, description TEXT, quantity REAL NOT NULL, unit_price REAL NOT NULL, vat_percent REAL DEFAULT 15, total_price REAL NOT NULL);
    CREATE TABLE IF NOT EXISTS payments (id INTEGER PRIMARY KEY AUTOINCREMENT, payment_number TEXT UNIQUE, payment_type TEXT CHECK(payment_type IN ('receipt','payment')), payment_date DATE, customer_id INTEGER, vendor_id INTEGER, invoice_id INTEGER, amount REAL NOT NULL, payment_method TEXT DEFAULT 'cash', reference_number TEXT);
    CREATE TABLE IF NOT EXISTS journal_entries (id INTEGER PRIMARY KEY AUTOINCREMENT, entry_number TEXT NOT NULL UNIQUE, entry_date DATE NOT NULL, description TEXT, reference_type TEXT, reference_id INTEGER, is_posted INTEGER DEFAULT 0);
    CREATE TABLE IF NOT EXISTS journal_entry_lines (id INTEGER PRIMARY KEY AUTOINCREMENT, journal_entry_id INTEGER NOT NULL, account_id INTEGER NOT NULL, description TEXT, debit REAL DEFAULT 0, credit REAL DEFAULT 0);
    CREATE TABLE IF NOT EXISTS general_ledger (id INTEGER PRIMARY KEY AUTOINCREMENT, account_id INTEGER NOT NULL, entry_date DATE NOT NULL, journal_entry_id INTEGER, description TEXT, debit REAL DEFAULT 0, credit REAL DEFAULT 0);
    CREATE TABLE IF NOT EXISTS settings (key TEXT PRIMARY KEY, value TEXT);
    CREATE TABLE IF NOT EXISTS users (id INTEGER PRIMARY KEY AUTOINCREMENT, username TEXT NOT NULL UNIQUE, password_hash TEXT NOT NULL, full_name TEXT NOT NULL, role TEXT DEFAULT 'user' CHECK(role IN ('admin','manager','accountant','user')));
  `);
}

function seedData() {
  if (db.prepare("SELECT COUNT(*) as count FROM users").get().count > 0) return;
  // دليل حسابات مختصر
  const accounts = [
    ["1000","الأصول","asset",1],["1100","النقدية","asset",2],["1110","الصندوق","asset",3],["1120","البنوك","asset",3],
    ["1200","العملاء","asset",2],["1300","المخزون","asset",2],["2000","الخصوم","liability",1],
    ["2100","الموردين","liability",2],["2200","ضريبة القيمة المضافة","liability",2],
    ["3000","حقوق الملكية","equity",1],["4000","الإيرادات","income",1],["4100","المبيعات","income",2],
    ["5000","المصروفات","expense",1],["5100","تكلفة المبيعات","expense",2]
  ];
  const stmt = db.prepare("INSERT INTO accounts (code,name,type,level) VALUES (?,?,?,?)");
  accounts.forEach(a => stmt.run(...a));
  // مستخدم افتراضي
  db.prepare("INSERT INTO users (username,password_hash,full_name,role) VALUES (?,?,?,?)")
    .run("admin", bcrypt.hashSync("admin123", 10), "مدير النظام", "admin");
  // إعدادات
  db.prepare("INSERT OR IGNORE INTO settings (key,value) VALUES ('company_name','شركة تاليا')").run();
  db.prepare("INSERT OR IGNORE INTO settings (key,value) VALUES ('vat_rate','15')").run();
}
function getDb() { return db; }
module.exports = { initDatabase, getDb };
'@
